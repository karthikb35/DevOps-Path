# Force LF line endings for all text files
* text=auto eol=lf

# Explicitly LF for CI/config files
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.txt text eol=lf
*.cfg text eol=lf

# Binary files — no line-ending conversion
*.png binary
*.jpg binary
*.pdf binary